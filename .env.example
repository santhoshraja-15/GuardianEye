# GuardianEye Environment Configuration Template
# Copy to .env for local runtime settings

# ==============================================================================
# 1. APPLICATION & SERVER
# ==============================================================================
PROJECT_NAME="GuardianEye"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
WORKERS=4
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# 2. CORS & SECURITY
# ==============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]
ALLOWED_HOSTS=["*"]

# ==============================================================================
# 3. DATABASE (POSTGRESQL + PGVECTOR)
# ==============================================================================
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="guardian"
POSTGRES_PASSWORD="guardian_password"
POSTGRES_DB="guardian_eye"
DATABASE_URL="postgresql+psycopg://guardian:guardian_password@localhost:5432/guardian_eye"
# Fallback test SQLite database URL
TEST_DATABASE_URL="sqlite+aiosqlite:///:memory:"

# ==============================================================================
# 4. REDIS & CELERY (MESSAGE QUEUES)
# ==============================================================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# ==============================================================================
# 5. OBJECT STORAGE (MINIO / S3)
# ==============================================================================
STORAGE_TYPE="local" # "local" or "minio" / "s3"
LOCAL_STORAGE_DIR="./storage/data"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="guardian-eye-evidence"
MINIO_USE_SSL=False

# ==============================================================================
# 6. AI & COMPUTER VISION PIPELINE
# ==============================================================================
YOLO_MODEL_PATH="./models/detection/yolov8n.pt"
YOLO_DEVICE="cuda" # "cuda", "cpu", or "mps"
DETECTION_CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
INFERENCE_FPS=10 # Target sampling rate for AI inference (independent of video source FPS)
MAX_TRACK_AGE_FRAMES=30
MIN_TRACK_HITS=3

# ==============================================================================
# 7. RISK & BEHAVIOUR ENGINE CONFIGURATION
# ==============================================================================
RISK_THRESHOLD_LOW=25.0
RISK_THRESHOLD_MEDIUM=50.0
RISK_THRESHOLD_HIGH=75.0
RISK_THRESHOLD_CRITICAL=90.0
ALERT_COOLDOWN_SECONDS=10.0
AUTO_EVIDENCE_GENERATION=True

# ==============================================================================
# 8. AI ASSISTANT & LLM (OPTIONAL / EXTENSIBLE)
# ==============================================================================
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_PROVIDER="gemini" # "gemini", "openai", or "mock"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# ==============================================================================
# 9. MONITORING & LOGGING
# ==============================================================================
LOG_LEVEL="INFO"
PROMETHEUS_METRICS_ENABLED=True
PROMETHEUS_PORT=9090
